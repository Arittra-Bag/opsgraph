# Alpha defaults make no outbound network requests.
OPSGRAPH_MODE=sample
OPSGRAPH_API_KEY=replace-with-a-long-random-value
OPSGRAPH_WORKSPACE_ID=sample-workspace
OPSGRAPH_EGRESS_ENABLED=false
OPSGRAPH_MODEL_PROVIDER=deterministic
OPSGRAPH_STATE_PATH=.opsgraph/state.db

# Connected PostgreSQL: store only this variable name in OpsGraph, never its value.
OPSGRAPH_POSTGRES_SECRET_REF=OPSGRAPH_SOURCE_DSN
OPSGRAPH_SOURCE_DSN=postgresql://readonly_user:replace@127.0.0.1:5432/app

# Local OpenAI-compatible provider (Ollama/vLLM). Loopback needs no external egress.
OPSGRAPH_LOCAL_MODEL_URL=http://ollama:11434/v1
OPSGRAPH_LOCAL_MODEL=qwen3:8b
OPSGRAPH_OPENAI_API_KEY=

# Optional external inference is disabled unless explicitly enabled.
OPSGRAPH_ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=false
