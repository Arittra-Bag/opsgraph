# Prefer `opsgraph init` to create a private .env with a random workspace key.
# No source credential or synthetic fallback is bundled.
OPSGRAPH_MODE=connected
OPSGRAPH_API_KEY=replace-with-a-long-random-value
OPSGRAPH_WORKSPACE_ID=local
OPSGRAPH_EGRESS_ENABLED=false
OPSGRAPH_MODEL_PROVIDER=openai_compatible
OPSGRAPH_STATE_PATH=.opsgraph/state.db

# Connected PostgreSQL: store only this variable name in OpsGraph, never its value.
OPSGRAPH_POSTGRES_SECRET_REF=OPSGRAPH_SOURCE_DSN
OPSGRAPH_ALLOWED_POSTGRES_SECRET_REFS=OPSGRAPH_SOURCE_DSN
OPSGRAPH_POSTGRES_ALLOWED_SCHEMAS=public
OPSGRAPH_SOURCE_DSN=

# Local OpenAI-compatible provider (Ollama/vLLM). Loopback needs no external egress.
OPSGRAPH_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
OPSGRAPH_LOCAL_MODEL=qwen3:8b
# Qwen3 on Ollama: disable thinking for bounded structured responses.
# Remove this setting for providers/models that do not support reasoning_effort.
OPSGRAPH_LOCAL_REASONING_EFFORT=none
# Ollama grammar compatibility; full length limits remain enforced by OpsGraph.
OPSGRAPH_LOCAL_SCHEMA_PROFILE=ollama
OPSGRAPH_PROVIDER_TIMEOUT_SECONDS=30
OPSGRAPH_OPENAI_API_KEY=

# Optional external inference is disabled unless explicitly enabled.
OPSGRAPH_ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=false
